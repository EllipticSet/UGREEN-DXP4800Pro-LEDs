#!/bin/bash
set -Eeuo pipefail

# UGREEN DXP4800 Pro front-panel LEDs for Unraid.
# The kernel modules are distributed separately for each exact Unraid kernel.

plugin_dir=/boot/config/plugins/UGREEN-DXP4800Pro-LEDs
config_file=${UGREEN_PRO_CONFIG:-$plugin_dir/settings.cfg}
pid_file=${UGREEN_PRO_PID_FILE:-/run/ugreen-pro-leds.pid}
lock_file=${UGREEN_PRO_LOCK_FILE:-/run/ugreen-pro-leds.lock}
ready_file=/run/ugreen-pro-leds.ready
log_file=${UGREEN_PRO_LOG_FILE:-/var/log/ugreen-pro-leds.log}
status_dir=${UGREEN_PRO_STATUS_DIR:-/run/ugreen-pro-leds.status}
identify_file=${UGREEN_PRO_IDENTIFY_FILE:-/run/ugreen-pro-leds.identify}
notify_command=/usr/local/emhttp/webGui/scripts/notify
IDENTIFY_SECONDS=30

POWER_COLOR='255 255 255'
POWER_BRIGHTNESS=179
NIGHT_MODE=0
NIGHT_START='23:00'
NIGHT_END='07:00'
NIGHT_BRIGHTNESS=51
NIGHT_KEEP_WARNINGS=1
NETWORK_INTERFACE=auto
NETWORK_BRIGHTNESS=179
NETWORK_COLOR_ONLINE='255 255 255'
NETWORK_COLOR_OFFLINE='255 165 0'
CONNECTIVITY_METHOD=https
CONNECTIVITY_URL='https://unraid.net/'
CONNECTIVITY_FALLBACK_URL='https://ai.ugreen.com/'
CONNECTIVITY_INTERVAL=60
DISK_COLOR='255 255 255'
DISK_COLOR_FAILED='255 165 0'
DISK_BRIGHTNESS=179
DISK_STANDBY_BREATHING=1
DISK_ACTIVITY_STYLE=dark
DISK_PULSE_MS=80
DISK_ATA_PORTS=(1 2 3 4)
POLL_INTERVAL=0.5
REFRESH_INTERVAL=15
DISK_STATUS_INTERVAL=60

if [[ -f $config_file && ( ${1:-} == run || ${1:-} == shutdown || ${1:-} == detect ) ]]; then
  # Parse known settings and validate before sourcing canonical shell output.
  # Stop/status must remain usable even if an administrator damaged the config.
  if canonical=$(php /usr/local/emhttp/plugins/UGREEN-DXP4800Pro-LEDs/settings-cli.php "$config_file"); then
    source /dev/stdin <<< "$canonical"
  elif [[ ${1:-} == run ]]; then
    echo 'Invalid settings; refusing to start.' >&2; exit 1
  elif [[ ${1:-} == shutdown ]]; then
    echo 'Invalid settings; using default power colour for shutdown.' >&2
  else
    echo 'Invalid settings; using default network interface selection.' >&2
  fi
fi

log() { printf '%s %s\n' "$(date '+%F %T')" "$*"; }
fail() { log "ERROR: $*" >&2; exit 1; }
led_path() { printf '/sys/class/leds/%s' "$1"; }

# Unraid notification; unavailable early in boot or outside Unraid.
notify_admin() {
  [[ -x $notify_command ]] || return 0
  "$notify_command" -e 'UGREEN DXP4800 Pro LEDs' -s "$1" -d "$2" -i alert >/dev/null 2>&1 || true
}

# Live state for the settings page, one atomically replaced file per writer.
write_status() {
  [[ -d $status_dir ]] || return 0
  { printf '%s\n' "$2" > "$status_dir/.$1.tmp" && mv -f "$status_dir/.$1.tmp" "$status_dir/$1"; } 2>/dev/null || true
}

# Night mode applies between NIGHT_START and NIGHT_END (local time, HH:MM);
# the window may cross midnight. An optional HHMM argument replaces the clock.
night_active() {
  local now=${1:-} start end
  [[ $NIGHT_MODE == 1 ]] || return 1
  [[ -n $now ]] || printf -v now '%(%H%M)T' -1
  now=$((10#$now)); start=$((10#${NIGHT_START/:/})); end=$((10#${NIGHT_END/:/}))
  if (( start < end )); then (( now >= start && now < end ))
  else (( now >= start || now < end )); fi
}

# Store in $1 the brightness for configured level $2. During night mode the
# level is capped at NIGHT_BRIGHTNESS; warnings ($3 = 1) may keep their level.
led_level() {
  local -n level_out=$1
  level_out=$2
  [[ ${night:-0} == 1 ]] || return 0
  [[ ${3:-0} == 1 && $NIGHT_KEEP_WARNINGS == 1 ]] && return 0
  (( NIGHT_BRIGHTNESS >= level_out )) || level_out=$NIGHT_BRIGHTNESS
}

model_check() {
  [[ $(cat /sys/class/dmi/id/product_name) == 'DXP4800 Pro' ]] ||
    fail 'This plugin supports only DXP4800 Pro.'
}

module_loaded() { grep -q "^${1}[[:space:]]" /proc/modules; }

setup_hardware() {
  model_check
  local kernel module
  kernel=$(uname -r)
  module="/usr/local/lib/ugreen-pro-leds/$kernel/led-ugreen.ko"
  if [[ ! -f $module ]]; then
    notify_admin "LED driver missing for kernel $kernel" 'Front-panel LED control is unavailable. Update UGREEN DXP4800 Pro LEDs to a version that supports this Unraid release.'
    fail "No packaged LED module for kernel $kernel. Update the plugin before using this kernel."
  fi
  command -v modinfo >/dev/null || fail 'Missing dependency: modinfo'
  [[ $(modinfo -F vermagic "$module") == "$kernel "* ]] || fail "Wrong LED module release for kernel $kernel."
  for cmd in i2cget modprobe insmod flock jq smartctl timeout ip curl; do
    command -v "$cmd" >/dev/null || fail "Missing dependency: $cmd"
  done
  modprobe i2c-dev
  modprobe i2c-i801
  modprobe ledtrig-oneshot
  modprobe ledtrig-netdev
  if module_loaded led_ugreen; then
    [[ -r /sys/module/led_ugreen/parameters/write_protocol &&
       $(cat /sys/module/led_ugreen/parameters/write_protocol) == legacy ]] ||
      fail 'Another LED module is loaded. Remove other LED plugins and reboot.'
  else
    insmod "$module" write_protocol=legacy num_disk_leds=4
  fi
  local path name bus client found=''
  for path in /sys/class/i2c-dev/i2c-*; do
    [[ -r $path/name && $(cat "$path/name") == *'SMBus I801 adapter'* ]] || continue
    name=${path##*/}; bus=${name#i2c-}; client=/sys/bus/i2c/devices/${bus}-003a
    if [[ -e $client ]]; then
      [[ $(cat "$client/name") == led-ugreen ]] || fail 'LED address owned by another driver.'
      [[ -z $found ]] || fail 'Multiple LED controllers found.'
      found=$name
    elif [[ $(i2cget -y "$bus" 0x3a 0x5a w 2>/dev/null || true) == 0xc5b2 ]]; then
      [[ -z $found ]] || fail 'Multiple LED controllers found.'
      found=$name
    fi
  done
  [[ -n $found ]] || fail 'LED MCU not found on Intel SMBus I801.'
  client=/sys/bus/i2c/devices/${found#i2c-}-003a
  if [[ ! -e $client ]]; then
    printf 'led-ugreen 0x3a\n' > "/sys/bus/i2c/devices/$found/new_device"
    printf '%s\n' "$found" > /run/ugreen-pro-leds.owned-bus
  fi
  [[ -L $client/driver && $(basename "$(readlink -f "$client/driver")") == led-ugreen ]] || fail 'LED MCU failed to bind.'
  for name in power netdev disk1 disk2 disk3 disk4; do
    path=$(led_path "$name")
    [[ $(readlink -f "$path/device") == "$(readlink -f "$client")" && -w $path/color && -w $path/blink_type ]] ||
      fail "Unexpected LED owner or missing interface: $name"
  done
  log "LED MCU bound on $found using Intel legacy protocol."
  write_status controller "$found"
}

pick_network_interface() {
  if [[ $NETWORK_INTERFACE != auto ]]; then
    printf '%s\n' "$NETWORK_INTERFACE"
  else
    ip -o route show default | awk 'NR == 1 { print $5 }'
  fi
}

https_reachable() {
  local iface=$1 url=$2
  [[ -n $url ]] || return 1
  curl --silent --fail --head --location --output /dev/null --connect-timeout 2 \
    --max-time 5 --interface "$iface" "$url"
}

internet_reachable() {
  local iface=$1 gateway
  case $CONNECTIVITY_METHOD in
    https)
      https_reachable "$iface" "$CONNECTIVITY_URL" ||
        https_reachable "$iface" "$CONNECTIVITY_FALLBACK_URL" ;;
    gateway)
      gateway=$(ip -4 route show default dev "$iface" | awk 'NR == 1 { print $3 }')
      [[ -n $gateway ]] && ping -n -c 1 -W 2 -I "$iface" "$gateway" >/dev/null 2>&1 ;;
    none) return 0 ;;
    *) fail "Unknown CONNECTIVITY_METHOD: $CONNECTIVITY_METHOD" ;;
  esac
}

network_status() {
  local status="mode=$1"$'\n'"interface=$2"$'\n'"problem=${network_problem:-}"
  [[ $status != "${last_network_status:-}" ]] || return 0
  write_status network "$status"
  last_network_status=$status
}

configure_network() {
  local iface carrier color mode level warning=1 problem=''
  if night_active; then night=1; else night=0; fi
  iface=$(pick_network_interface)
  carrier=$(cat "/sys/class/net/$iface/carrier" 2>/dev/null || true)
  if [[ -z $iface ]]; then
    problem='No default route found; the LAN LED shows Internet unavailable.'
  elif [[ ! -e /sys/class/net/$iface ]]; then
    problem="Network interface $iface not found; the LAN LED shows Internet unavailable."
  fi
  if [[ $problem != "${network_problem:-}" ]]; then
    [[ -z $problem ]] || log "WARNING: $problem"
    network_problem=$problem
  fi
  if (( NETWORK_BRIGHTNESS == 0 )); then
    if [[ ${current_network_mode:-} != off ]]; then
      printf 'none\n' > /sys/class/leds/netdev/trigger
      printf 'none\n' > /sys/class/leds/netdev/blink_type
      printf '0\n' > /sys/class/leds/netdev/brightness
      current_network_mode=off
    fi
    network_status off "$iface"
    return 0
  fi
  mode=down
  if [[ -n $iface && $carrier == 1 ]]; then
    if [[ ${current_network_interface:-} != "$iface" || ${current_network_mode:-} == down ]] ||
       (( SECONDS >= ${next_connectivity_check:-0} )); then
      if internet_reachable "$iface"; then network_online=1; else network_online=0; fi
      next_connectivity_check=$((SECONDS + CONNECTIVITY_INTERVAL))
    fi
    if [[ ${network_online:-0} == 1 ]]; then mode=online; else mode=offline; fi
  fi
  if [[ $mode == online ]]; then color=$NETWORK_COLOR_ONLINE; warning=0; else color=$NETWORK_COLOR_OFFLINE; fi
  led_level level "$NETWORK_BRIGHTNESS" "$warning"
  if [[ ${current_network_interface:-} != "$iface" || ${current_network_mode:-} != "$mode" ||
        ${current_network_level:-} != "$level" ]]; then
    printf 'none\n' > /sys/class/leds/netdev/trigger
    printf 'none\n' > /sys/class/leds/netdev/blink_type
    printf '%s\n' "$color" > /sys/class/leds/netdev/color
    printf '%s\n' "$level" > /sys/class/leds/netdev/brightness
    if [[ $mode != down ]] && (( level > 0 )); then
      printf 'netdev\n' > /sys/class/leds/netdev/trigger
      printf '%s\n' "$iface" > /sys/class/leds/netdev/device_name
      printf '1\n' > /sys/class/leds/netdev/link
      printf '1\n' > /sys/class/leds/netdev/rx
      printf '1\n' > /sys/class/leds/netdev/tx
      printf '100\n' > /sys/class/leds/netdev/interval
    fi
    current_network_interface=$iface
    current_network_mode=$mode
    current_network_level=$level
    log "Network LED: $mode on $iface, brightness $level."
  fi
  network_status "$mode" "$iface"
}

network_worker() {
  trap - EXIT
  trap 'exit 0' TERM INT
  while :; do configure_network; for ((pause=0; pause<5; pause++)); do sleep 1; done; done
}

device_on_ata_port() {
  local port=$1 block path
  [[ $port != 0 ]] || return 1
  for block in /sys/class/block/sd*; do
    [[ -e $block/device && ! -e $block/partition ]] || continue
    path=$(readlink -f "$block/device")
    if [[ $path == *"/ata${port}/"* ]]; then
      printf '%s\n' "${block##*/}"
      return 0
    fi
  done
  return 1
}

# bay_mode holds the drive state; bay_light the lighting applied ("mode brightness").
declare -A bay_device bay_signature bay_mode bay_light

# Sectors read and written; SMART commands do not change these counters.
disk_signature() {
  local -a counters
  [[ -r /sys/class/block/$1/stat ]] || return 1
  read -r -a counters < "/sys/class/block/$1/stat" || return 1
  (( ${#counters[@]} >= 7 )) || return 1
  printf '%s:%s\n' "${counters[2]}" "${counters[6]}"
}

set_bay_mode() {
  local bay=$1 mode=$2 path lighting_mode brightness warning=0
  [[ $mode != failed ]] || warning=1
  led_level brightness "$DISK_BRIGHTNESS" "$warning"
  lighting_mode=$mode
  if (( brightness == 0 )); then lighting_mode=off
  elif [[ $mode == standby && $DISK_STANDBY_BREATHING == 0 ]]; then lighting_mode=active; fi
  [[ ${bay_mode[$bay]:-} == "$mode" && ${bay_light[$bay]:-} == "$lighting_mode $brightness" ]] && return 0
  # An identified bay keeps flashing; its mode is applied when identification ends.
  if [[ $bay == "${identify_bay:-}" ]]; then bay_mode[$bay]=$mode; bay_light[$bay]=''; return 0; fi
  path=$(led_path "disk$bay")
  printf 'none\n' > "$path/trigger"
  case $lighting_mode in
    off)
      printf 'none\n' > "$path/blink_type"
      printf '0\n' > "$path/brightness" ;;
    active)
      printf 'none\n' > "$path/blink_type"
      case $DISK_ACTIVITY_STYLE in
        solid)
          printf '0\n' > "$path/brightness"
          printf '%s\n' "$brightness" > "$path/brightness"
          printf 'oneshot\n' > "$path/trigger"
          printf '1\n' > "$path/invert"
          printf '1\n' > "$path/delay_on"
          printf '%s\n' "$DISK_PULSE_MS" > "$path/delay_off"
          printf '%s\n' "$DISK_COLOR" > "$path/color"
          printf '%s\n' "$brightness" > "$path/brightness"
          printf 'none\n' > "$path/blink_type" ;;
        dark)
          printf '%s\n' "$DISK_COLOR" > "$path/color"
          printf '0\n' > "$path/brightness"
          printf 'oneshot\n' > "$path/trigger"
          printf '0\n' > "$path/invert"
          printf '%s\n' "$DISK_PULSE_MS" > "$path/delay_on"
          printf '100\n' > "$path/delay_off"
          # Pulses use the brightness present when a software blink starts.
          # Light the LED at the effective level and send one pulse, which
          # ends dark, so later pulses use this level instead of the maximum.
          printf '%s\n' "$brightness" > "$path/brightness"
          printf '1\n' > "$path/shot" ;;
        *) fail "Unknown DISK_ACTIVITY_STYLE: $DISK_ACTIVITY_STYLE" ;;
      esac ;;
    standby)
      printf '%s\n' "$brightness" > "$path/brightness"
      printf '%s\n' "$DISK_COLOR" > "$path/color"
      printf 'breath 1000 1000\n' > "$path/blink_type" ;;
    failed)
      printf '%s\n' "$brightness" > "$path/brightness"
      printf '%s\n' "$DISK_COLOR_FAILED" > "$path/color"
      printf 'blink 500 500\n' > "$path/blink_type" ;;
    *) fail "Unknown disk LED mode: $mode" ;;
  esac
  bay_mode[$bay]=$mode
  bay_light[$bay]="$lighting_mode $brightness"
  log "disk$bay: $mode, brightness $brightness."
}

disk_health_mode() {
  local device=$1 status
  status=$(timeout 5 smartctl -n standby,0 -H -j "/dev/$device" 2>/dev/null || true)
  [[ -n $status ]] || { printf 'active\n'; return; }
  jq -r 'if ((.power_mode.name // "") | ascii_upcase) == "STANDBY" then "standby"
         elif .smart_status.passed == false then "failed"
         else "active" end' <<< "$status" 2>/dev/null || printf 'active\n'
}

refresh_bay_health() {
  local bay device mode recorded before after
  before=$(standby_bays)
  for bay in 1 2 3 4; do
    device=${bay_device[$bay]:-}
    [[ -n $device ]] || continue
    mode=active
    recorded=''
    if [[ -r $state_dir/"$device" ]]; then read -r mode recorded < "$state_dir/$device" || mode=active; fi
    [[ $mode == active || $mode == standby || $mode == failed ]] || mode=active
    # A standby result is stale if I/O occurred after the SMART check started.
    if [[ $mode == standby && -n $recorded && $(disk_signature "$device" || true) != "$recorded" ]]; then
      mode=active
    fi
    set_bay_mode "$bay" "$mode"
  done
  after=$(standby_bays)
  if [[ $before != "$after" && -n $after ]]; then synchronize_standby_breathing; fi
}

standby_bays() {
  local bay
  for bay in 1 2 3 4; do
    [[ ${bay_light[$bay]:-} != standby\ * ]] || printf '%s ' "$bay"
  done
  return 0
}

synchronize_standby_breathing() {
  [[ $DISK_STANDBY_BREATHING == 1 ]] || return 0
  local bay path
  # The MCU has no exposed shared phase. Reset all sleeping LEDs first; then
  # start their identical hardware cycles together when membership changes.
  # Writing breath alone is insufficient: the driver caches unchanged modes.
  for bay in 1 2 3 4; do
    [[ ${bay_light[$bay]:-} == standby\ * && $bay != "${identify_bay:-}" ]] || continue
    path=$(led_path "disk$bay")
    printf 'none\n' > "$path/blink_type"
  done
  for bay in 1 2 3 4; do
    [[ ${bay_light[$bay]:-} == standby\ * && $bay != "${identify_bay:-}" ]] || continue
    path=$(led_path "disk$bay")
    printf 'breath 1000 1000\n' > "$path/blink_type"
  done
}

bay_led_off() {
  local path
  [[ $1 != "${identify_bay:-}" ]] || return 0
  bay_light[$1]=''
  path=$(led_path "disk$1")
  printf 'none\n' > "$path/trigger"
  printf 'none\n' > "$path/blink_type"
  printf '0\n' > "$path/brightness"
}

configure_bay() {
  local bay=$1 port=$2 led="disk$1" device path
  path=$(led_path "$led")
  [[ -d $path ]] || return 0
  if [[ $port == 0 ]]; then
    if [[ ${bay_mode[$bay]:-} != disabled ]]; then
      bay_led_off "$bay"
      bay_device[$bay]=''
      bay_signature[$bay]=''
      bay_mode[$bay]=disabled
    fi
    return 0
  fi
  device=$(device_on_ata_port "$port" || true)
  if [[ ${bay_device[$bay]-unset} == "$device" ]]; then return 0; fi
  if [[ -n $device ]]; then
    rm -f -- "$state_dir/$device"
    bay_device[$bay]=$device
    bay_mode[$bay]=''
    bay_signature[$bay]=''
    log "$led monitors ATA port $port ($device)."
  else
    if [[ -n ${bay_device[$bay]:-} ]]; then
      set_bay_mode "$bay" failed
      log "$led: previously present drive disappeared (failure or removal)."
    else
      bay_led_off "$bay"
      bay_mode[$bay]=''
    fi
    bay_device[$bay]=''
    bay_signature[$bay]=''
    log "$led: no device currently found on ATA port $port."
  fi
}

poll_disk_activity() {
  local bay device path signature
  for bay in 1 2 3 4; do
    device=${bay_device[$bay]:-}
    [[ -n $device ]] || continue
    signature=$(disk_signature "$device") || continue
    path=$(led_path "disk$bay")
    if [[ -n ${bay_signature[$bay]:-} && ${bay_signature[$bay]} != "$signature" ]]; then
      if [[ ${bay_mode[$bay]:-} == standby ]]; then
        rm -f -- "$state_dir/$device"
        set_bay_mode "$bay" active
      fi
      if [[ ${bay_light[$bay]:-} == active\ * && $bay != "${identify_bay:-}" ]]; then
        printf '1\n' > "$path/shot"
      fi
      [[ ${UGREEN_PRO_DEBUG:-0} == 1 ]] && log "Activity on disk$bay ($device)."
    fi
    bay_signature[$bay]=$signature
  done
}

# Flash one bay LED quickly so the drive can be located; normal state returns afterwards.
check_identify() {
  local bay='' until=0 path
  [[ ! -f $identify_file ]] || read -r bay until < "$identify_file" || true
  if [[ $bay =~ ^[1-4]$ && $until =~ ^[0-9]+$ ]] && (( EPOCHSECONDS < until )); then
    [[ $bay != "${identify_bay:-}" ]] || return 0
    end_identify
    identify_bay=$bay
    path=$(led_path "disk$bay")
    printf 'none\n' > "$path/trigger"
    printf '%s\n' "$DISK_COLOR" > "$path/color"
    printf '255\n' > "$path/brightness"
    printf 'blink 200 200\n' > "$path/blink_type"
    log "disk$bay: identify for $((until - EPOCHSECONDS)) seconds."
    return 0
  fi
  [[ ! -f $identify_file ]] || rm -f "$identify_file"
  end_identify
}

end_identify() {
  local bay=${identify_bay:-} mode
  [[ -n $bay ]] || return 0
  identify_bay=''
  mode=${bay_mode[$bay]:-}
  case $mode in
    active|standby|failed|off)
      bay_mode[$bay]=identify
      set_bay_mode "$bay" "$mode"
      [[ $mode != standby ]] || synchronize_standby_breathing ;;
    *) bay_led_off "$bay" ;;
  esac
  log "disk$bay: identify ended."
}

bays_status() {
  local bay port mode status=''
  for bay in 1 2 3 4; do
    port=${DISK_ATA_PORTS[bay-1]}
    mode=${bay_mode[$bay]:-}
    if [[ $bay == "${identify_bay:-}" ]]; then mode=identify
    elif [[ $port == 0 ]]; then mode=disabled
    elif [[ -z ${bay_device[$bay]:-} && $mode != failed ]]; then mode=empty
    elif [[ -z $mode ]]; then mode=active
    elif [[ ${bay_light[$bay]:-} == off\ * ]]; then mode=off
    fi
    status+="bay=$bay port=$port device=${bay_device[$bay]:-} mode=$mode"$'\n'
  done
  [[ $status != "${last_bays_status:-}" ]] || return 0
  write_status bays "${status%$'\n'}"
  last_bays_status=$status
}

health_worker() {
  local port device mode signature pause
  trap - EXIT
  trap 'exit 0' TERM INT
  while :; do
    for port in "${DISK_ATA_PORTS[@]}"; do
      device=$(device_on_ata_port "$port" || true)
      [[ -n $device ]] || continue
      signature=$(disk_signature "$device" || true)
      mode=$(disk_health_mode "$device")
      printf '%s %s\n' "$mode" "$signature" > "$state_dir/$device.tmp"
      mv -f "$state_dir/$device.tmp" "$state_dir/$device"
    done
    for ((pause=0; pause<DISK_STATUS_INTERVAL; pause++)); do sleep 1; done
  done
}

# Apply a change between day and night brightness to the power and drive LEDs.
# The network worker evaluates night mode on its own schedule.
update_night() {
  local was=${night:-} level bay
  if night_active; then night=1; else night=0; fi
  [[ $night != "$was" ]] || return 0
  write_status night "$night"
  [[ -n $was ]] || return 0
  if [[ $night == 1 ]]; then log 'Night mode started.'; else log 'Night mode ended.'; fi
  led_level level "$POWER_BRIGHTNESS"
  printf '%s\n' "$level" > /sys/class/leds/power/brightness
  for bay in 1 2 3 4; do
    case ${bay_mode[$bay]:-} in
      active|standby|failed) set_bay_mode "$bay" "${bay_mode[$bay]}" ;;
    esac
  done
  synchronize_standby_breathing
}

cleanup() {
  local child bay
  for child in "${network_pid:-}" "${health_pid:-}"; do
    [[ -n $child ]] || continue
    kill "$child" 2>/dev/null || true
  done
  for child in "${network_pid:-}" "${health_pid:-}"; do
    [[ -z $child ]] || wait "$child" 2>/dev/null || true
  done
  # Release LEDs managed by this monitor and turn them off. Leave power on.
  if [[ ${hardware_ready:-0} == 1 ]]; then
    printf 'none\n' > /sys/class/leds/netdev/trigger || true
    printf 'none\n' > /sys/class/leds/netdev/blink_type || true
    printf '0\n' > /sys/class/leds/netdev/brightness || true
    for bay in 1 2 3 4; do
      [[ ${DISK_ATA_PORTS[bay-1]} != 0 || $bay == "${identify_bay:-}" ]] || continue
      printf 'none\n' > "/sys/class/leds/disk$bay/trigger" || true
      printf 'none\n' > "/sys/class/leds/disk$bay/blink_type" || true
      printf '0\n' > "/sys/class/leds/disk$bay/brightness" || true
    done
  fi
  rm -f "$pid_file" "$ready_file" "$identify_file"
  rm -rf -- "$status_dir"
  [[ -z ${state_dir:-} ]] || rm -rf -- "$state_dir"
}

run() {
  exec 9> "$lock_file"
  flock -n 9 || fail 'LED monitor is already running.'
  rm -f "$ready_file"
  printf '%s\n' "$$" > "$pid_file"
  trap cleanup EXIT
  trap 'exit 0' TERM INT
  rm -rf -- "$status_dir" "$identify_file"
  mkdir -p "$status_dir"
  setup_hardware
  hardware_ready=1
  state_dir=$(mktemp -d /run/ugreen-pro-leds.health.XXXXXX)
  update_night
  local power_level
  led_level power_level "$POWER_BRIGHTNESS"
  printf 'none\n' > /sys/class/leds/power/trigger
  printf 'none\n' > /sys/class/leds/power/blink_type
  printf '%s\n' "$POWER_COLOR" > /sys/class/leds/power/color
  # The MCU can report "on" after boot while the physical power LED is dark.
  # Cycle it so the driver sends an explicit on command instead of skipping it.
  printf '0\n' > /sys/class/leds/power/brightness
  sleep 0.1
  printf '%s\n' "$power_level" > /sys/class/leds/power/brightness
  network_worker 9>&- &
  network_pid=$!
  health_worker 9>&- &
  health_pid=$!
  printf ready > "$ready_file"
  local bay next_refresh=0 next_disk_status=0
  while :; do
    if (( SECONDS >= next_refresh )); then
      for bay in 1 2 3 4; do
        configure_bay "$bay" "${DISK_ATA_PORTS[bay-1]}"
      done
      next_refresh=$((SECONDS + REFRESH_INTERVAL))
    fi
    if (( SECONDS >= next_disk_status )); then
      refresh_bay_health
      next_disk_status=$((SECONDS + 2))
    fi
    update_night
    check_identify
    bays_status
    poll_disk_activity
    kill -0 "$network_pid" 2>/dev/null || fail 'Network worker stopped.'
    kill -0 "$health_pid" 2>/dev/null || fail 'Health worker stopped.'
    sleep "$POLL_INTERVAL"
  done
}

running_pid() {
  local pid
  local -a argv=()
  [[ -r $pid_file ]] || return 1
  read -r pid < "$pid_file" || return 1
  [[ $pid =~ ^[0-9]+$ && -r /proc/$pid/cmdline ]] || return 1
  mapfile -d '' -t argv < "/proc/$pid/cmdline" || return 1
  [[ ${argv[1]:-} == "$0" && ${argv[2]:-} == run ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  printf '%s\n' "$pid"
}

[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0

case ${1:-} in
  run) run ;;
  start)
    if running_pid >/dev/null && [[ -f $ready_file ]]; then
      echo 'UGREEN Pro LED monitor is already running.'
      exit 0
    fi
    if running_pid >/dev/null; then fail 'Monitor is still initializing; check status before restarting.'; fi
    nohup "$0" run >> "$log_file" 2>&1 < /dev/null &
    started_pid=$!
    for _ in {1..12}; do
      sleep 1
      kill -0 "$started_pid" 2>/dev/null || fail "Monitor exited; see $log_file."
      if running_pid >/dev/null && [[ -f $ready_file ]]; then
        echo 'UGREEN Pro LED monitor started.'; exit 0
      fi
    done
    kill "$started_pid" 2>/dev/null || true
    fail "Monitor did not become ready; see $log_file."
    ;;
  stop)
    if pid=$(running_pid); then
      kill "$pid" 2>/dev/null || true
      flock -w 15 "$lock_file" true || fail 'Monitor did not stop.'
    fi
    ;;
  shutdown)
    "$0" stop
    flock -w 10 "$lock_file" true || true
    if [[ -w /sys/class/leds/power/blink_type ]]; then
      printf 'none\n' > /sys/class/leds/power/trigger
      printf '%s\n' "$POWER_COLOR" > /sys/class/leds/power/color
      printf '%s\n' "$POWER_BRIGHTNESS" > /sys/class/leds/power/brightness
      if (( POWER_BRIGHTNESS > 0 )); then
        printf 'blink 500 500\n' > /sys/class/leds/power/blink_type
      else
        printf 'none\n' > /sys/class/leds/power/blink_type
        printf '0\n' > /sys/class/leds/power/brightness
      fi
    fi
    ;;
  status)
    if running_pid >/dev/null && [[ -f $ready_file ]]; then
      echo 'UGREEN Pro LED monitor is running.'
    else
      echo 'UGREEN Pro LED monitor is stopped.'
      exit 1
    fi
    ;;
  identify)
    bay=${2:-}; seconds=${3:-$IDENTIFY_SECONDS}
    [[ $bay =~ ^([1-4]|off)$ && $seconds =~ ^[0-9]{1,3}$ ]] && (( seconds >= 1 && seconds <= 300 )) ||
      { echo "Usage: $0 identify {1|2|3|4|off} [seconds 1-300]" >&2; exit 2; }
    running_pid >/dev/null && [[ -f $ready_file ]] || fail 'LED monitor is not running.'
    if [[ $bay == off ]]; then
      rm -f "$identify_file"; echo 'Bay identification stopped.'; exit 0
    fi
    printf '%s %s\n' "$bay" "$((EPOCHSECONDS + seconds))" > "$identify_file.tmp"
    mv -f "$identify_file.tmp" "$identify_file"
    echo "Bay $bay LED flashes for $seconds seconds."
    ;;
  detect)
    printf 'Model: '; cat /sys/class/dmi/id/product_name
    printf 'Kernel: '; uname -r
    printf 'SATA devices and ATA ports (no serial numbers):\n'
    for port in {1..32}; do
      device=$(device_on_ata_port "$port" || true)
      [[ -z $device ]] || printf 'ata%s -> /dev/%s\n' "$port" "$device"
    done
    printf 'Network default route interface: %s\n' "$(pick_network_interface)"
    ;;
  diagnostics)
    # Text report for support requests: no serial numbers, MAC or IP addresses.
    printf 'UGREEN DXP4800 Pro LEDs diagnostics\n'
    printf 'Generated: %(%F %T %Z)T\n' -1
    printf 'Plugin version: %s\n' "$(cat /usr/local/emhttp/plugins/UGREEN-DXP4800Pro-LEDs/version.txt 2>/dev/null || echo unknown)"
    printf 'Unraid version: %s\n' "$(sed -n 's/^version="\([^"]*\)"$/\1/p' /etc/unraid-version 2>/dev/null || true)"
    printf '\n== Monitor\n'
    "$0" status 2>&1 || true
    printf '\n== Detection\n'
    "$0" detect 2>&1 || true
    printf '\n== LED driver\n'
    if [[ -d /sys/module/led_ugreen ]]; then
      printf 'led_ugreen loaded, write protocol: %s\n' "$(cat /sys/module/led_ugreen/parameters/write_protocol 2>/dev/null || echo unknown)"
    else
      printf 'led_ugreen not loaded\n'
    fi
    printf 'Packaged kernels: %s\n' "$(cd /usr/local/lib/ugreen-pro-leds 2>/dev/null && printf '%s ' */ | sed 's@/@@g' || true)"
    printf '\n== Current state\n'
    for file in controller network night bays; do
      [[ -f $status_dir/$file ]] || continue
      printf -- '-- %s\n' "$file"; cat "$status_dir/$file"
    done
    printf '\n== Settings\n'
    if [[ -f $config_file ]]; then grep -v -e '^#' -e '^$' "$config_file"; else printf 'Defaults (no settings file)\n'; fi
    printf '\n== Log (last 200 lines)\n'
    tail -n 200 "$log_file" 2>/dev/null || printf 'No log file\n'
    ;;
  *) echo "Usage: $0 {start|stop|shutdown|status|detect|identify|diagnostics|run}" >&2; exit 2 ;;
esac
