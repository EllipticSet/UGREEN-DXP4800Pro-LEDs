#!/bin/bash
set -Eeuo pipefail

# UGREEN DXP4800 Pro front-panel LEDs for Unraid.
# The kernel modules are distributed separately for each exact Unraid kernel.

plugin_dir=/boot/config/plugins/UGREEN-DXP4800Pro-LEDs
config_file=${UGREEN_PRO_CONFIG:-$plugin_dir/settings.cfg}
pid_file=${UGREEN_PRO_PID_FILE:-/run/ugreen-pro-leds.pid}
lock_file=${UGREEN_PRO_LOCK_FILE:-/run/ugreen-pro-leds.lock}
ready_file=/run/ugreen-pro-leds.ready
log_file=${UGREEN_PRO_LOG_FILE:-/var/log/ugreen-pro-leds.log}

POWER_COLOR='255 255 255'
POWER_BRIGHTNESS=180
NETWORK_INTERFACE=auto
NETWORK_BRIGHTNESS=180
NETWORK_COLOR_ONLINE='255 255 255'
NETWORK_COLOR_OFFLINE='255 165 0'
CONNECTIVITY_METHOD=https
CONNECTIVITY_URL='https://unraid.net/'
CONNECTIVITY_FALLBACK_URL='https://ai.ugreen.com/'
CONNECTIVITY_INTERVAL=60
DISK_COLOR='255 255 255'
DISK_COLOR_FAILED='255 165 0'
DISK_BRIGHTNESS=180
DISK_ACTIVITY_STYLE=dark
DISK_PULSE_MS=80
DISK_ATA_PORTS=(0 0 0 0)
POLL_INTERVAL=0.5
REFRESH_INTERVAL=15
DISK_STATUS_INTERVAL=60

if [[ -f $config_file && ( ${1:-} == run || ${1:-} == shutdown ) ]]; then
  # Parse known settings and validate before sourcing canonical shell output.
  # Stop/status must remain usable even if an administrator damaged the config.
  if canonical=$(php /usr/local/emhttp/plugins/UGREEN-DXP4800Pro-LEDs/settings-cli.php "$config_file"); then
    source /dev/stdin <<< "$canonical"
  elif [[ ${1:-} == run ]]; then
    echo 'Invalid settings; refusing to start.' >&2; exit 1
  else
    echo 'Invalid settings; using default power colour for shutdown.' >&2
  fi
fi

log() { printf '%s %s\n' "$(date '+%F %T')" "$*"; }
fail() { log "ERROR: $*" >&2; exit 1; }
led_path() { printf '/sys/class/leds/%s' "$1"; }

model_check() {
  [[ $(cat /sys/class/dmi/id/product_name) == 'DXP4800 Pro' ]] ||
    fail 'This plugin supports only DXP4800 Pro.'
}

module_loaded() { grep -q "^${1}[[:space:]]" /proc/modules; }

setup_hardware() {
  model_check
  [[ $(uname -r) == 6.18.38-Unraid ]] || fail 'Exact kernel 6.18.38-Unraid required.'
  for cmd in i2cget modprobe insmod flock jq smartctl timeout ip curl; do
    command -v "$cmd" >/dev/null || fail "Missing dependency: $cmd"
  done
  modprobe i2c-dev
  modprobe i2c-i801
  modprobe ledtrig-oneshot
  modprobe ledtrig-netdev
  if module_loaded led_ugreen; then
    [[ -r /sys/module/led_ugreen/parameters/write_protocol &&
       $(cat /sys/module/led_ugreen/parameters/write_protocol) == legacy ]] ||
      fail 'Another LED module is loaded. Remove other LED plugins and reboot.'
  else
    insmod /usr/local/lib/ugreen-pro-leds/6.18.38-Unraid/led-ugreen.ko write_protocol=legacy num_disk_leds=4
  fi
  local path name bus client found=''
  for path in /sys/class/i2c-dev/i2c-*; do
    [[ -r $path/name && $(cat "$path/name") == *'SMBus I801 adapter'* ]] || continue
    name=${path##*/}; bus=${name#i2c-}; client=/sys/bus/i2c/devices/${bus}-003a
    if [[ -e $client ]]; then
      [[ $(cat "$client/name") == led-ugreen ]] || fail 'LED address owned by another driver.'
      [[ -z $found ]] || fail 'Multiple LED controllers found.'
      found=$name
    elif [[ $(i2cget -y "$bus" 0x3a 0x5a w 2>/dev/null || true) == 0xc5b2 ]]; then
      [[ -z $found ]] || fail 'Multiple LED controllers found.'
      found=$name
    fi
  done
  [[ -n $found ]] || fail 'LED MCU not found on Intel SMBus I801.'
  client=/sys/bus/i2c/devices/${found#i2c-}-003a
  if [[ ! -e $client ]]; then
    printf 'led-ugreen 0x3a\n' > "/sys/bus/i2c/devices/$found/new_device"
    printf '%s\n' "$found" > /run/ugreen-pro-leds.owned-bus
  fi
  [[ -L $client/driver && $(basename "$(readlink -f "$client/driver")") == led-ugreen ]] || fail 'LED MCU failed to bind.'
  for name in power netdev disk1 disk2 disk3 disk4; do
    path=$(led_path "$name")
    [[ $(readlink -f "$path/device") == "$(readlink -f "$client")" && -w $path/color && -w $path/blink_type ]] ||
      fail "Unexpected LED owner or missing interface: $name"
  done
  log "LED MCU bound on $found using Intel legacy protocol."
}

pick_network_interface() {
  if [[ $NETWORK_INTERFACE != auto ]]; then
    printf '%s\n' "$NETWORK_INTERFACE"
  else
    ip -o route show default | awk 'NR == 1 { print $5 }'
  fi
}

https_reachable() {
  local iface=$1 url=$2
  [[ -n $url ]] || return 1
  curl --silent --fail --head --location --output /dev/null --connect-timeout 2 \
    --max-time 5 --interface "$iface" "$url"
}

internet_reachable() {
  local iface=$1 gateway
  case $CONNECTIVITY_METHOD in
    https)
      https_reachable "$iface" "$CONNECTIVITY_URL" ||
        https_reachable "$iface" "$CONNECTIVITY_FALLBACK_URL" ;;
    gateway)
      gateway=$(ip -4 route show default dev "$iface" | awk 'NR == 1 { print $3 }')
      [[ -n $gateway ]] && ping -n -c 1 -W 2 -I "$iface" "$gateway" >/dev/null 2>&1 ;;
    none) return 0 ;;
    *) fail "Unknown CONNECTIVITY_METHOD: $CONNECTIVITY_METHOD" ;;
  esac
}

configure_network() {
  local iface carrier color mode
  iface=$(pick_network_interface)
  carrier=$(cat "/sys/class/net/$iface/carrier" 2>/dev/null || true)
  mode=down
  if [[ -n $iface && $carrier == 1 ]]; then
    if [[ ${current_network_interface:-} != "$iface" || ${current_network_mode:-} == down ]] ||
       (( SECONDS >= ${next_connectivity_check:-0} )); then
      if internet_reachable "$iface"; then network_online=1; else network_online=0; fi
      next_connectivity_check=$((SECONDS + CONNECTIVITY_INTERVAL))
    fi
    if [[ ${network_online:-0} == 1 ]]; then mode=online; else mode=offline; fi
  fi
  if [[ $mode == online ]]; then color=$NETWORK_COLOR_ONLINE; else color=$NETWORK_COLOR_OFFLINE; fi
  if [[ ${current_network_interface:-} != "$iface" || ${current_network_mode:-} != "$mode" ]]; then
    printf 'none\n' > /sys/class/leds/netdev/trigger
    printf 'none\n' > /sys/class/leds/netdev/blink_type
    printf '%s\n' "$color" > /sys/class/leds/netdev/color
    printf '%s\n' "$NETWORK_BRIGHTNESS" > /sys/class/leds/netdev/brightness
    if [[ $mode != down ]]; then
      printf 'netdev\n' > /sys/class/leds/netdev/trigger
      printf '%s\n' "$iface" > /sys/class/leds/netdev/device_name
      printf '1\n' > /sys/class/leds/netdev/link
      printf '1\n' > /sys/class/leds/netdev/rx
      printf '1\n' > /sys/class/leds/netdev/tx
      printf '100\n' > /sys/class/leds/netdev/interval
    fi
    current_network_interface=$iface
    current_network_mode=$mode
    log "Network LED: $mode on $iface."
  fi
}

network_worker() {
  trap - EXIT
  trap 'exit 0' TERM INT
  while :; do configure_network; for ((pause=0; pause<5; pause++)); do sleep 1; done; done
}

device_on_ata_port() {
  local port=$1 block path
  [[ $port != 0 ]] || return 1
  for block in /sys/class/block/sd*; do
    [[ -e $block/device && ! -e $block/partition ]] || continue
    path=$(readlink -f "$block/device")
    if [[ $path == *"/ata${port}/"* ]]; then
      printf '%s\n' "${block##*/}"
      return 0
    fi
  done
  return 1
}

declare -A bay_device bay_signature bay_mode

set_bay_mode() {
  local bay=$1 mode=$2 path
  [[ ${bay_mode[$bay]:-} == "$mode" ]] && return 0
  path=$(led_path "disk$bay")
  printf 'none\n' > "$path/trigger"
  case $mode in
    active)
      printf 'none\n' > "$path/blink_type"
      case $DISK_ACTIVITY_STYLE in
        solid)
          printf '0\n' > "$path/brightness"
          printf '%s\n' "$DISK_BRIGHTNESS" > "$path/brightness"
          printf 'oneshot\n' > "$path/trigger"
          printf '1\n' > "$path/invert"
          printf '1\n' > "$path/delay_on"
          printf '%s\n' "$DISK_PULSE_MS" > "$path/delay_off"
          printf '%s\n' "$DISK_COLOR" > "$path/color"
          printf '%s\n' "$DISK_BRIGHTNESS" > "$path/brightness"
          printf 'none\n' > "$path/blink_type" ;;
        dark)
          printf '%s\n' "$DISK_COLOR" > "$path/color"
          printf '0\n' > "$path/brightness"
          printf 'oneshot\n' > "$path/trigger"
          printf '0\n' > "$path/invert"
          printf '%s\n' "$DISK_PULSE_MS" > "$path/delay_on"
          printf '100\n' > "$path/delay_off" ;;
        *) fail "Unknown DISK_ACTIVITY_STYLE: $DISK_ACTIVITY_STYLE" ;;
      esac ;;
    standby)
      printf '%s\n' "$DISK_BRIGHTNESS" > "$path/brightness"
      printf '%s\n' "$DISK_COLOR" > "$path/color"
      printf 'breath 1000 1000\n' > "$path/blink_type" ;;
    failed)
      printf '%s\n' "$DISK_BRIGHTNESS" > "$path/brightness"
      printf '%s\n' "$DISK_COLOR_FAILED" > "$path/color"
      printf 'blink 500 500\n' > "$path/blink_type" ;;
    *) fail "Unknown disk LED mode: $mode" ;;
  esac
  bay_mode[$bay]=$mode
  log "disk$bay: $mode."
}

disk_health_mode() {
  local device=$1 status
  status=$(timeout 5 smartctl -n standby,0 -H -j "/dev/$device" 2>/dev/null || true)
  [[ -n $status ]] || { printf 'active\n'; return; }
  jq -r 'if ((.power_mode.name // "") | ascii_upcase) == "STANDBY" then "standby"
         elif .smart_status.passed == false then "failed"
         else "active" end' <<< "$status" 2>/dev/null || printf 'active\n'
}

refresh_bay_health() {
  local bay device mode
  for bay in 1 2 3 4; do
    device=${bay_device[$bay]:-}
    [[ -n $device ]] || continue
    mode=active
    if [[ -r $state_dir/"$device" ]]; then read -r mode < "$state_dir/$device" || mode=active; fi
    [[ $mode == active || $mode == standby || $mode == failed ]] || mode=active
    set_bay_mode "$bay" "$mode"
  done
}

configure_bay() {
  local bay=$1 port=$2 led="disk$1" device path
  path=$(led_path "$led")
  [[ -d $path && $port != 0 ]] || return 0
  device=$(device_on_ata_port "$port" || true)
  if [[ ${bay_device[$bay]-unset} == "$device" ]]; then return 0; fi
  if [[ -n $device ]]; then
    rm -f -- "$state_dir/$device"
    bay_device[$bay]=$device
    bay_mode[$bay]=''
    bay_signature[$bay]=''
    log "$led monitors ATA port $port ($device)."
  else
    if [[ -n ${bay_device[$bay]:-} ]]; then
      set_bay_mode "$bay" failed
      log "$led: previously present drive disappeared (failure or removal)."
    else
      printf 'none\n' > "$path/trigger"
      printf 'none\n' > "$path/blink_type"
      printf '0\n' > "$path/brightness"
      bay_mode[$bay]=''
    fi
    bay_device[$bay]=''
    bay_signature[$bay]=''
    log "$led: no device currently found on ATA port $port."
  fi
}

poll_disk_activity() {
  local bay device path signature
  local -a counters
  for bay in 1 2 3 4; do
    device=${bay_device[$bay]:-}
    [[ -n $device && -r /sys/class/block/$device/stat ]] || continue
    read -r -a counters < "/sys/class/block/$device/stat" || continue
    (( ${#counters[@]} >= 7 )) || continue
    signature="${counters[2]}:${counters[6]}"
    path=$(led_path "disk$bay")
    if [[ -n ${bay_signature[$bay]:-} && ${bay_signature[$bay]} != "$signature" ]]; then
      if [[ ${bay_mode[$bay]:-} == standby ]]; then
        rm -f -- "$state_dir/$device"
        set_bay_mode "$bay" active
      fi
      if [[ ${bay_mode[$bay]:-} == active ]]; then
        printf '1\n' > "$path/shot"
      fi
      [[ ${UGREEN_PRO_DEBUG:-0} == 1 ]] && log "Activity on disk$bay ($device)."
    fi
    bay_signature[$bay]=$signature
  done
}

health_worker() {
  local port device mode pause
  trap - EXIT
  trap 'exit 0' TERM INT
  while :; do
    for port in "${DISK_ATA_PORTS[@]}"; do
      device=$(device_on_ata_port "$port" || true)
      [[ -n $device ]] || continue
      mode=$(disk_health_mode "$device")
      printf '%s\n' "$mode" > "$state_dir/$device.tmp"
      mv -f "$state_dir/$device.tmp" "$state_dir/$device"
    done
    for ((pause=0; pause<DISK_STATUS_INTERVAL; pause++)); do sleep 1; done
  done
}

cleanup() {
  local child bay
  for child in "${network_pid:-}" "${health_pid:-}"; do
    [[ -n $child ]] || continue
    kill "$child" 2>/dev/null || true
  done
  for child in "${network_pid:-}" "${health_pid:-}"; do
    [[ -z $child ]] || wait "$child" 2>/dev/null || true
  done
  # Release only LED triggers managed by this monitor. Leave power solid white.
  if [[ ${hardware_ready:-0} == 1 ]]; then
    printf 'none\n' > /sys/class/leds/netdev/trigger || true
    printf 'none\n' > /sys/class/leds/netdev/blink_type || true
    for bay in 1 2 3 4; do
      [[ ${DISK_ATA_PORTS[bay-1]} != 0 ]] || continue
      printf 'none\n' > "/sys/class/leds/disk$bay/trigger" || true
      printf 'none\n' > "/sys/class/leds/disk$bay/blink_type" || true
      printf '0\n' > "/sys/class/leds/disk$bay/brightness" || true
    done
  fi
  rm -f "$pid_file" "$ready_file"
  [[ -z ${state_dir:-} ]] || rm -rf -- "$state_dir"
}

run() {
  exec 9> "$lock_file"
  flock -n 9 || fail 'LED monitor is already running.'
  rm -f "$ready_file"
  printf '%s\n' "$$" > "$pid_file"
  trap cleanup EXIT
  trap 'exit 0' TERM INT
  setup_hardware
  hardware_ready=1
  state_dir=$(mktemp -d /run/ugreen-pro-leds.health.XXXXXX)
  printf 'none\n' > /sys/class/leds/power/trigger
  printf 'none\n' > /sys/class/leds/power/blink_type
  printf '%s\n' "$POWER_COLOR" > /sys/class/leds/power/color
  # The MCU can report "on" after boot while the physical power LED is dark.
  # Cycle it so the driver sends an explicit on command instead of skipping it.
  printf '0\n' > /sys/class/leds/power/brightness
  sleep 0.1
  printf '%s\n' "$POWER_BRIGHTNESS" > /sys/class/leds/power/brightness
  network_worker 9>&- &
  network_pid=$!
  health_worker 9>&- &
  health_pid=$!
  printf ready > "$ready_file"
  local bay next_refresh=0 next_disk_status=0
  while :; do
    if (( SECONDS >= next_refresh )); then
      for bay in 1 2 3 4; do
        configure_bay "$bay" "${DISK_ATA_PORTS[bay-1]}"
      done
      next_refresh=$((SECONDS + REFRESH_INTERVAL))
    fi
    if (( SECONDS >= next_disk_status )); then
      refresh_bay_health
      next_disk_status=$((SECONDS + 2))
    fi
    poll_disk_activity
    kill -0 "$network_pid" 2>/dev/null || fail 'Network worker stopped.'
    kill -0 "$health_pid" 2>/dev/null || fail 'Health worker stopped.'
    sleep "$POLL_INTERVAL"
  done
}

running_pid() {
  local pid
  local -a argv=()
  [[ -r $pid_file ]] || return 1
  read -r pid < "$pid_file" || return 1
  [[ $pid =~ ^[0-9]+$ && -r /proc/$pid/cmdline ]] || return 1
  mapfile -d '' -t argv < "/proc/$pid/cmdline" || return 1
  [[ ${argv[1]:-} == "$0" && ${argv[2]:-} == run ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  printf '%s\n' "$pid"
}

[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0

case ${1:-} in
  run) run ;;
  start)
    if running_pid >/dev/null && [[ -f $ready_file ]]; then
      echo 'UGREEN Pro LED monitor is already running.'
      exit 0
    fi
    if running_pid >/dev/null; then fail 'Monitor is still initializing; check status before restarting.'; fi
    nohup "$0" run >> "$log_file" 2>&1 < /dev/null &
    started_pid=$!
    for attempt in {1..12}; do
      sleep 1
      kill -0 "$started_pid" 2>/dev/null || fail "Monitor exited; see $log_file."
      if running_pid >/dev/null && [[ -f $ready_file ]]; then
        echo 'UGREEN Pro LED monitor started.'; exit 0
      fi
    done
    kill "$started_pid" 2>/dev/null || true
    fail "Monitor did not become ready; see $log_file."
    ;;
  stop)
    if pid=$(running_pid); then
      kill "$pid" 2>/dev/null || true
      flock -w 15 "$lock_file" true || fail 'Monitor did not stop.'
    fi
    ;;
  shutdown)
    "$0" stop
    flock -w 10 "$lock_file" true || true
    if [[ -w /sys/class/leds/power/blink_type ]]; then
      printf 'none\n' > /sys/class/leds/power/trigger
      printf '%s\n' "$POWER_COLOR" > /sys/class/leds/power/color
      printf '%s\n' "$POWER_BRIGHTNESS" > /sys/class/leds/power/brightness
      printf 'blink 500 500\n' > /sys/class/leds/power/blink_type
    fi
    ;;
  status)
    if running_pid >/dev/null && [[ -f $ready_file ]]; then
      echo 'UGREEN Pro LED monitor is running.'
    else
      echo 'UGREEN Pro LED monitor is stopped.'
      exit 1
    fi
    ;;
  detect)
    printf 'Model: '; cat /sys/class/dmi/id/product_name
    printf 'Kernel: '; uname -r
    printf 'SATA devices and ATA ports (no serial numbers):\n'
    for port in {1..32}; do
      device=$(device_on_ata_port "$port" || true)
      [[ -z $device ]] || printf 'ata%s -> /dev/%s\n' "$port" "$device"
    done
    printf 'Network default route interface: %s\n' "$(pick_network_interface)"
    ;;
  *) echo "Usage: $0 {start|stop|shutdown|status|detect|run}" >&2; exit 2 ;;
esac
