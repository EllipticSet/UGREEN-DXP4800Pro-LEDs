<?xml version='1.0' encoding='utf-8'?>
<PLUGIN name="UGREEN-DXP4800Pro-LEDs" author="EllipticSet" pluginURL="https://raw.githubusercontent.com/EllipticSet/UGREEN-DXP4800Pro-LEDs/main/UGREEN-DXP4800Pro-LEDs.plg" support="https://github.com/EllipticSet/UGREEN-DXP4800Pro-LEDs/issues" version="2026.10.02.3" icon="lightbulb-o" launch="Settings/UGREEN-DXP4800Pro-LEDs" min="7.3.2" max="7.3.2">
  <CHANGES>
###2026.10.02.3
- Public GitHub and Community Applications metadata; preserve settings on updates with rollback.
- English plugin listing and documentation; compact title and description.
- Keep the native Unraid CSRF fix.
- Experimental DXP4800 Pro build: Intel legacy I801, isolated workers, native settings, offline installer.
</CHANGES>
  <FILE Run="/bin/bash">
    <INLINE>set -euo pipefail
scratch=$(mktemp -d /tmp/ugreen-pro-install.XXXXXX)
trap 'rm -rf -- "$scratch"' EXIT
base64 -d &gt; "$scratch/bundle.tar.xz" &lt;&lt;'UGREEN_PAYLOAD'
